{
  description = "NixOS configuration for Loom"; # A descriptive name for your flake

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/master"; # Master branch (unstable)
    home-manager = {
      url = "github:nix-community/home-manager/master"; # Master branch (unstable)
      inputs.nixpkgs.follows = "nixpkgs"; # Ensures home-manager uses the same nixpkgs
    };
    nixos-hardware.url = "github:NixOS/nixos-hardware/master"; # Hardware definitions
    
};

  outputs = { self, nixpkgs, home-manager, nixos-hardware, linux-surface, ... }: {
    nixosConfigurations = {
      Loom = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux"; # Your system architecture
        modules = [
          ./nixos/configuration.nix # Path to your main configuration
          home-manager.nixosModules.home-manager {
            home-manager.useGlobalPkgs = true;
            home-manager.useUserPackages = true;
            home-manager.users.tarobutter = import ./home.nix; # Path to your home-manager config
          }
          nixos-hardware.nixosModules.microsoft-surface-book2 # Your specific hardware module
        ];
      };
    };
  };
}
