#!/usr/bin/env bash
## ~~~~~ -!!- ~~~~~ -!!- ~~~~~ -!!- ~~~~~ -!!- ~~~~~ -!!- ~~~~~ -!!- ~~~~~ ##
## refresh — Lodestone NixOS rebuild tool
##
## Usage:
##   refresh                        rebuild this machine
##   refresh <host>                 rebuild target host
##   refresh <host> --by <builder>  explicitly set build host
##   refresh <host> --self          target machine builds itself
##   refresh <host> --dry           dry run, no apply
##
## ~~~~~ -!!- ~~~~~ -!!- ~~~~~ -!!- ~~~~~ -!!- ~~~~~ -!!- ~~~~~ -!!- ~~~~~ ##
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

log()     { echo -e "${BLUE}==>${NC} ${BOLD}$*${NC}"; }
success() { echo -e "${GREEN}==>${NC} ${BOLD}$*${NC}"; }
warn()    { echo -e "${YELLOW}==>${NC} $*"; }
error()   { echo -e "${RED}==>${NC} $*" >&2; exit 1; }

TARGET=""
BUILDER=""
DRY=false
SELF_BUILD=false

while [[ $# -gt 0 ]]; do
  case $1 in
    --by)
      [[ -z "${2:-}" ]] && error "--by requires a hostname argument"
      BUILDER="$2"; shift 2 ;;
    --self)
      SELF_BUILD=true; shift ;;
    --dry)
      DRY=true; shift ;;
    --help|-h)
      grep '^##' "$0" | sed 's/^## \?//'; exit 0 ;;
    -*)
      error "Unknown flag: $1. Run 'refresh --help' for usage." ;;
    *)
      [[ -n "$TARGET" ]] && error "Too many positional arguments"
      TARGET="$1"; shift ;;
  esac
done

SELF=$(hostname)
TARGET=${TARGET:-$SELF}

FLAKE_DIR="${LODESTONE_ROOT:-$(git -C "$(dirname "$0")" rev-parse --show-toplevel 2>/dev/null)}"
[[ -z "$FLAKE_DIR" ]] && error "Could not locate Lodestone flake root."

log "Pulling latest from origin (hard reset to origin/main)..."
git -C "$FLAKE_DIR" fetch origin
git -C "$FLAKE_DIR" reset --hard origin/main
success "Up to date with origin/main"

DEFAULT_BUILDER="island"

if [[ "$SELF_BUILD" == true ]]; then
  BUILDER="$TARGET"
  log "Self-build — $TARGET will build itself"
elif [[ -n "$BUILDER" ]]; then
  log "Using explicit builder: $BUILDER"
elif tailscale ping --c 1 "$DEFAULT_BUILDER" &>/dev/null 2>&1; then
  BUILDER="$DEFAULT_BUILDER"
  success "Island reachable — using as build host"
else
  BUILDER="$TARGET"
  warn "Island unreachable — falling back to self-build on $TARGET"
fi

IS_LOCAL=false
[[ "$BUILDER" == "$SELF" ]] && IS_LOCAL=true
[[ "$TARGET" == "$SELF" && "$BUILDER" == "$TARGET" ]] && IS_LOCAL=true

SUBCOMMAND="switch"
[[ "$DRY" == true ]] && SUBCOMMAND="dry-run"

CMD=(sudo nixos-rebuild "$SUBCOMMAND" --flake "$FLAKE_DIR#$TARGET")

if [[ "$IS_LOCAL" == false ]]; then
  CMD+=(--build-host  "tarobutter@$BUILDER")
  CMD+=(--target-host "tarobutter@$TARGET")
  CMD+=(--use-remote-sudo)
fi

echo ""
echo -e "${BOLD}  Target:   ${NC}$TARGET"
echo -e "${BOLD}  Builder:  ${NC}$BUILDER"
echo -e "${BOLD}  Flake:    ${NC}$FLAKE_DIR"
echo -e "${BOLD}  Mode:     ${NC}$SUBCOMMAND"
echo ""

LOG_FILE="/tmp/lodestone-rebuild-${TARGET}.log"
log "Running: ${CMD[*]}"
log "Log: $LOG_FILE"
echo ""

"${CMD[@]}" 2>&1 | tee "$LOG_FILE"
EXIT_CODE=${PIPESTATUS[0]}

echo ""
if [[ $EXIT_CODE -eq 0 ]]; then
  success "✓ $TARGET rebuilt successfully"
else
  error "✗ Rebuild failed (exit $EXIT_CODE). See $LOG_FILE"
fi
